rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'joinedAt']) &&
             data.uid == request.auth.uid &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.joinedAt is string;
    }

    function isValidResult(data) {
      return data.keys().hasAll(['id', 'userId', 'username', 'displayName', 'title', 'category', 'score', 'maxScore', 'percentage', 'grade', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.score is number &&
             data.maxScore is number && data.maxScore > 0 &&
             data.percentage is number &&
             data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 30 &&
             data.createdAt is string;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'resultId', 'userId', 'username', 'displayName', 'text', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.createdAt is string;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Results collection
    match /results/{resultId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(resultId) && isValidResult(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidResult(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Result comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidId(commentId) && isValidComment(request.resource.data);
        allow update: if false;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
